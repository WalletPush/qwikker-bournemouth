{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/email-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/offer-activations",
      "schedule": "*/10 * * * *"
    }
  ]
}
